+t('2a. tres órdenes seguidas: 0001, 0002, 0003', o1.numero === `OT-${anio}-0001` && o2.numero === `OT-${anio}-0002` && o3.numero === `OT-${anio}-0003`, [o1.numero, o2.numero, o3.numero].join(' '));
