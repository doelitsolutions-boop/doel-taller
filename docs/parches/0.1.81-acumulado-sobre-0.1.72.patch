+      console.log('GUARDA ' + k.ruta + ' a buen recaudo (copia fuera del PC): sin ella no se emiten licencias ni códigos.\n');
+    } else if (orden === 'emitir') {
+      const c = emitir({ equipo: arg('equipo'), cliente: arg('cliente'), modulos: arg('modulos') || [], modo: arg('modo') || 'permanente', caduca: arg('caduca') || null });
+      console.log('\nCódigo de activación DL2 para ' + arg('equipo').toUpperCase() + ' (' + arg('cliente') + '):\n\n' + c + '\n');
+      console.log('Mándaselo entero (WhatsApp/correo); se pega en Ajustes → Sistema → Licencia una sola vez.\n');
+    } else if (orden === 'codigo') {
+      const t = Math.floor(Date.now() / 1000 / 30);
+      console.log('\nCódigo de 6 dígitos para ' + arg('equipo').toUpperCase() + ':  ' + codigo({ equipo: arg('equipo'), contador: t }) + '   (caduca en ' + seg() + ' s; el siguiente será ' + codigo({ equipo: arg('equipo'), contador: t + 1 }) + ')\n');
+    } else if (orden === 'modulos') {
+      const lista = normalizarModulos(arg('modulos') || '');
+      console.log('\nMódulos que quedarán activos: ' + (lista.length ? lista.map((m) => m.replace('modulo_', '')).join(' · ') : '(ninguno)'));
+      console.log('Código de 12 dígitos para ' + arg('equipo').toUpperCase() + ':  ' + modulos({ equipo: arg('equipo'), modulos: lista }) + '   (caduca en ' + seg() + ' s)\n');
+    } else if (orden === 'qr') {
+      console.log('\n' + qr({ equipo: arg('equipo') }) + '\n\nPégalo en un generador de QR y escanéalo con el autenticador: una entrada por cliente.\n');
+    } else {
+      console.log(fs.readFileSync(__filename, 'utf8').split('*/')[0].replace(/^\/\*\s?/, ''));
+      process.exit(orden ? 1 : 0);
+    }
+  } catch (e) { console.error('\n✗ ' + e.message + '\n'); process.exit(1); }
+}
