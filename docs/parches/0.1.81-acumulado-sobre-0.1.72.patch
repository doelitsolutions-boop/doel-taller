+const vf2 = db.saludCompleta().checks.find((c) => c.id === 'verifactu');
+t('4d. un ticket heredado sin nif_emisor se verifica con el NIF actual (y por eso ahora avisa, como antes)', vf2 && vf2.nivel !== 'ok');
