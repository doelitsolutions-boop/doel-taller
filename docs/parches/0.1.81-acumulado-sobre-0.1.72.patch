+const indices = () => new Set(raw().prepare("SELECT name FROM sqlite_master WHERE type='index'").all().map((r) => r.name));
+const fks = (tabla) => raw().prepare(`PRAGMA foreign_key_list(${tabla})`).all().map((f) => f.from + '→' + f.table + (f.on_delete && f.on_delete !== 'NO ACTION' ? ':' + f.on_delete : ''));
