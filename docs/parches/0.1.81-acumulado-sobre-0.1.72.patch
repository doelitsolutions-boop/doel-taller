index 0000000..2e7fee1
--- /dev/null
+++ b/electron/seguridad-app.cjs
@@ -0,0 +1,56 @@
+/* v0.1.73 · Seguridad del PROCESO PRINCIPAL (lo que no es red): ventanas, Panel de Desarrollador y
+   claves de configuración protegidas. seguridad-lan.cjs cubre los dos servidores de la LAN; esto cubre
+   al propio mostrador. Sacado de main.cjs para que no vuelva a pasar de 1 400 líneas (auditoría #4). */
+const { shell } = require('electron');
+const seg = require('./seguridad-lan.cjs');
+
+/* SEC-20 · ninguna ventana con preload navega fuera de la app ni abre hijas con el puente.
+   Sin setWindowOpenHandler, window.open / target=_blank creaban una ventana con las MISMAS
+   webPreferences (preload incluido): la web remota recibía window.doel entero. Ahora los enlaces
+   https se abren en el navegador del sistema y el resto se niega. */
+function endurecerVentana(w) {
+  const wc = w.webContents;
+  wc.setWindowOpenHandler(({ url }) => {
+    if (/^https:\/\//.test(url)) { try { shell.openExternal(url); } catch (e) { /* sin navegador: nada */ } }
+    return { action: 'deny' };
+  });
+  wc.on('will-navigate', (e, url) => {
+    if (!/^file:/.test(url) && !(process.env.VITE_DEV && /^http:\/\/localhost:5173/.test(url))) e.preventDefault();
+  });
+  wc.on('will-attach-webview', (e) => e.preventDefault());
+}
+
+/* SEC-12 · la puerta del Panel de Desarrollador vive AQUÍ, no en la pantalla.
+   Hasta la 0.1.72 `dev:acceso` solo devolvía true y era la pantalla la que decidía: desde DevTools o desde
+   cualquier cosa que hablara con el puente se llamaba a dev:renovar, dev:desactivar o dev:reset-operativa
+   sin código. Ahora un código válido abre el panel 30 minutos en el proceso principal, y los canales
+   peligrosos lo comprueban antes de hacer nada. */
+const PUERTA_MS = 30 * 60000;
+let devHasta = 0;
+const devAbierto = () => Date.now() < devHasta;
+const devAbrir = () => { devHasta = Date.now() + PUERTA_MS; };
+const devCerrar = () => { devHasta = 0; };
+const exigirDev = () => { if (!devAbierto()) throw new Error('Panel de Desarrollador cerrado: entra con el código del autenticador'); };
+const DEV_PUERTA = new Set(['dev:renovar', 'dev:desactivar', 'dev:reset-operativa', 'dev:reset-carta', 'dev:restaurar', 'dev:restaurar-todo', 'dev:reloj-reset', 'dev:guardar-todo']);
+
+/* Claves de config que solo escribe el Panel Dev con la puerta abierta: las del sello de licencia, la
+   activación, el arranque de la demo, el reloj y las credenciales que ya tienen su propio canal. Hasta
+   ahora `config:set('licencia_caduca', '2099-12-31')` desde el puente quedaba legitimado porque la app
+   volvía a sellar ella misma. `modulo_taller_lan` lo activa el admin desde Ajustes → Taller y no está
+   en el sello: queda fuera. */
+const CLAVE_PROTEGIDA = (k) => /^(licencia_|modulo_|activacion_|primer_arranque|reloj_|backup_clave|fichaje_admin_)/.test(String(k || ''))
+  && String(k) !== 'modulo_taller_lan';
+
+/* SEC-01 (parcial) · los códigos de licencia y del autenticador tienen un espacio pequeño (6 dígitos):
+   cinco fallos seguidos y cinco minutos sin aceptar más. Un acierto limpia el historial. */
+const frenoCodigos = seg.crearFreno(5, 5 * 60000);
+const conFreno = async (clave, fn) => {
+  const parado = frenoCodigos.bloqueo(clave);
+  if (parado) throw new Error('Demasiados intentos. Espera ' + parado.segundos + ' s y vuelve a probar');
+  try { const r = await fn(); frenoCodigos.acierto(clave); return r; }
+  catch (e) { frenoCodigos.fallo(clave); throw e; }
+};
+/* canal → clave del freno: lo aplica handle() de main.cjs, así el cuerpo de cada handler queda tal cual */
+const FRENO_CANAL = { 'licencia:activar': 'licencia', 'dev:acceso': 'dev' };
+
+module.exports = { endurecerVentana, devAbierto, devAbrir, devCerrar, exigirDev, DEV_PUERTA, CLAVE_PROTEGIDA, conFreno, FRENO_CANAL, frenoCodigos, PUERTA_MS };
