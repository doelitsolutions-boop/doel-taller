@@ -0,0 +1,59 @@
+#!/usr/bin/env node
+/* v0.1.77 · Genera electron/preload.cjs desde electron/canales.cjs (punto 4). El preload corre en el renderer
+   con sandbox, donde `require` solo da 'electron': no puede leer la tabla en caliente, así que se escribe
+   en frío y check-puente comprueba que coincide.  Uso: node tools/puente-generar.cjs [--comprobar] */
+const fs = require('fs');
+const path = require('path');
+const RAIZ = path.resolve(__dirname, '..');
+const canales = require(path.join(RAIZ, 'electron', 'canales.cjs'));
+
+function texto() {
+  const grupos = new Map(); // nombre → [items en orden]
+  for (const canal of Object.keys(canales.CANALES)) {
+    const d = canales.CANALES[canal]; if (!d.api) continue;
+    const [g, m] = d.api.split('.');
+    if (!grupos.has(g)) grupos.set(g, []);
+    grupos.get(g).push(d.firma ? `${m}: (${d.firma.join(', ')}) => call('${canal}')({ ${d.firma.join(', ')} })` : `${m}: call('${canal}')`);
+  }
+  for (const canal of Object.keys(canales.EVENTOS)) {
+    const d = canales.EVENTOS[canal]; const [g, m] = d.api.split('.');
+    if (!grupos.has(g)) grupos.set(g, []);
+    grupos.get(g).push(d.forma === 'dato' ? `${m}: (cb) => ipcRenderer.on('${canal}', (_e, n) => cb(n))` : `${m}: (cb) => ipcRenderer.on('${canal}', cb)`);
+  }
+  const lineas = [];
+  for (const [g, items] of grupos) {
+    let linea = `  ${g}: { `;
+    const salida = [];
+    items.forEach((it, i) => {
+      const pieza = it + (i < items.length - 1 ? ', ' : ' },');
+      if (linea.length + pieza.length > 160 && linea.trim().length > `${g}: {`.length) { salida.push(linea.replace(/\s+$/, '')); linea = '    ' + pieza; }
+      else linea += pieza;
+    });
+    salida.push(linea.replace(/\s+$/, ''));
+    lineas.push(salida.join('\n'));
+  }
+  return `/* GENERADO por \`node tools/puente-generar.cjs\` desde electron/canales.cjs · NO EDITAR A MANO (v0.1.77).
+   Para añadir un canal: su fila en canales.cjs, su handle() en main, y volver a generar. check-puente
+   falla si este fichero no coincide con la tabla. */
+const { contextBridge, ipcRenderer } = require('electron');
+
+const call = (canal) => (...args) => ipcRenderer.invoke(canal, ...args);
+
+contextBridge.exposeInMainWorld('doel', {
+${lineas.join('\n')}
+});
+`;
+}
+
+const destino = path.join(RAIZ, 'electron', 'preload.cjs');
+if (require.main === module) {
+  const nuevo = texto();
+  const actual = fs.existsSync(destino) ? fs.readFileSync(destino, 'utf8') : '';
+  if (process.argv.includes('--comprobar')) {
+    if (actual === nuevo) { console.log('preload.cjs coincide con canales.cjs'); process.exit(0); }
+    console.error('preload.cjs NO coincide con canales.cjs → node tools/puente-generar.cjs'); process.exit(1);
+  }
+  fs.writeFileSync(destino, nuevo);
+  console.log(actual === nuevo ? 'preload.cjs ya estaba al día' : 'preload.cjs regenerado desde canales.cjs');
+}
+module.exports = { texto, destino };
