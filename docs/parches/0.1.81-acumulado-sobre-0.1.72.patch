+raw().exec('DROP INDEX ux_ordenes_numero'); raw().prepare('INSERT INTO ordenes (numero, cliente_id, equipo_id) VALUES (?,?,?)').run(`OT-1999-0001`, cid, eqId);
+const sn = db.saludCompleta().checks.find((c) => c.id === 'ordenes_numero');
