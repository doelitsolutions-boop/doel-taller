+  }
+  for (const canal of Object.keys(EVENTOS)) {
+    const d = EVENTOS[canal];
+    if (!/^[a-z0-9]+\.[A-Za-z0-9]+$/.test(String(d.api))) err.push('evento ' + canal + ': api inválida');
