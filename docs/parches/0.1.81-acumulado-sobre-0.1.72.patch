+/* v0.1.78 · punto 5 del plan · Sesión LOCAL del mostrador: quién ha entrado con PIN en la pantalla de Electron.
+
+   Hasta la 0.1.77 el permiso por canal solo se comprobaba en el puesto en red (/rpc). En el propio mostrador
+   lo tapaba la pantalla: la barra esconde lo que el perfil no tiene, pero cualquier cosa que hable con el
+   puente (DevTools en desarrollo, una extensión, un fallo de la pantalla) podía llamar a config:set o
+   usuarios:save con un técnico dentro. Ahora handle() de main.cjs pregunta aquí en CADA llamada IPC, con la
+   misma tabla (canales.cjs) y la misma regla (permisos-canal.cjs) que el puesto en red.
+
+   Reglas:
+   · canal sin permiso → pasa siempre (lo que la pantalla lee antes de entrar: config, licencia, empresa…).
+   · canal con permiso y nadie dentro → no, salvo SIN_SESION: la activación de la licencia se hace con la
+     app bloqueada, antes de que haya con quién entrar.
+   · canal con permiso y alguien dentro → la regla de la barra; el perfil se relee de la base (baja o cambio
+     de permisos → efecto inmediato, como en el puesto en red).
+   · auth:login (variante IPC) abre la sesión; auth:logout la cierra. auth:verificar solo comprueba un PIN
+     (quién abre la caja en el TPV) y NO cambia de usuario: antes esa comprobación pasaba por auth:login
+     y en el puesto en red cambiaba la sesión al encargado para el resto del día. */
+const permisos = require('./permisos-canal.cjs');
+
+let sesion = null; // { id, nombre, rol, permisos }
+const SIN_SESION = new Set(['licencia:activar']);
+
+function entrar(u) {
+  sesion = u && u.id ? { id: u.id, nombre: u.nombre, rol: u.rol, permisos: u.permisos || null } : null;
+  return sesion;
+}
+function salir() { sesion = null; }
+const actual = () => sesion;
+
+/* null = adelante; texto = motivo de la negativa (handle() lo lanza como error y la pantalla lo enseña) */
+function autoriza(canal, db) {
+  const req = permisos.permisoDeCanal(canal);
+  if (!req) return null;
+  if (!sesion) return SIN_SESION.has(canal) ? null : 'Entra con tu PIN para hacer esto';
+  try {
+    const vivo = db && typeof db.usuarioVivo === 'function' ? db.usuarioVivo(sesion.id) : undefined;
+    if (vivo === null) { sesion = null; return 'Tu usuario ya no está activo'; }
+    if (vivo) { sesion.permisos = vivo.permisos || null; sesion.rol = vivo.rol; sesion.nombre = vivo.nombre; }
+  } catch (e) { /* base ocupada: se sigue con lo que tenía la sesión */ }
+  return permisos.autorizado(sesion, canal) ? null : 'Tu perfil no tiene permiso «' + req + '» para esto';
+}
+
+module.exports = { entrar, salir, actual, autoriza, SIN_SESION };
