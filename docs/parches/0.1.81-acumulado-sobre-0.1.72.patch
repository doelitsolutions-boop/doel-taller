+/* v0.1.81 · punto 8 · stub de @netlify/blobs EN MEMORIA para las baterías de la nube, compartido (antes cada batería
+   llevaba el suyo). Imita lo que api.mjs usa de verdad: get / getWithMetadata (con etag), set / setJSON con las
+   escrituras condicionales onlyIfMatch / onlyIfNew (devuelven { modified, etag }), list y delete. Sin el etag las
+   baterías no podrían demostrar que dos peticiones a la vez ya no se pisan. */
+const fs = require('fs');
+const path = require('path');
+const FUENTE = `
+const stores = new Map(); let seq = 0;
+export function getStore(nombre) {
+  if (!stores.has(nombre)) stores.set(nombre, new Map()); // clave → { v: texto, etag }
+  const m = stores.get(nombre);
+  const guardar = (k, texto, o) => {
+    const hay = m.get(k);
+    if (o && o.onlyIfNew && hay) return { modified: false };
+    if (o && o.onlyIfMatch && (!hay || hay.etag !== o.onlyIfMatch)) return { modified: false };
+    const etag = '"' + (++seq) + '"'; m.set(k, { v: texto, etag }); return { modified: true, etag };
+  };
+  const leer = (k, o) => { const e = m.get(k); if (!e) return null; return (o && o.type === 'json') ? JSON.parse(e.v) : e.v; };
+  return {
+    async get(k, o) { return leer(k, o); },
+    async getWithMetadata(k, o) { const e = m.get(k); if (!e) return null; return { data: leer(k, o), etag: e.etag, metadata: {} }; },
+    async setJSON(k, v, o) { return guardar(k, JSON.stringify(v), o); },
+    async set(k, v, o) { return guardar(k, String(v), o); },
+    async delete(k) { m.delete(k); },
+    async list() { return { blobs: [...m.keys()].map((key) => ({ key, etag: m.get(key).etag })), directories: [] }; },
+  };
+}
+export const __stores = stores;
+`;
+function escribir(RAIZ) {
+  const dir = path.join(RAIZ, 'node_modules', '@netlify', 'blobs');
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, 'package.json'), JSON.stringify({ name: '@netlify/blobs', version: '0.0.0', type: 'module', main: 'index.mjs' }));
+  fs.writeFileSync(path.join(dir, 'index.mjs'), FUENTE);
+  return dir;
+}
+module.exports = { FUENTE, escribir };
