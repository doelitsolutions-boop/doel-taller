+/* ══ 🔑 Batería · Licencia v2 (0.1.74): códigos DL2 firmados por Doel + semilla TOTP por instalación ═══
+   Lo que cierra SEC-01 de la auditoría 0.1.72: la app ya no lleva ningún secreto con el que fabricar
+   licencias. Aquí se genera un par de claves DE PRUEBA en una carpeta temporal (nunca las de Doel), se
+   emite un código para ESTE equipo y se recorre todo: activar, sellar, renovar y fijar módulos por
+   teléfono, rechazar lo de otro equipo o lo manipulado, y la migración de una activación anterior.
+   Ejecutar:  node tools/test-licencia-v2.cjs */
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const crypto = require('crypto');
+const lic = require('../electron/licencia.cjs');
+const LV2 = require('./licencia-v2.cjs');
+let ok = 0, ko = 0;
+const t = (n, c, extra = '') => { if (c) { ok++; console.log('  OK  ' + n); } else { ko++; console.log('  ✗   ' + n + (extra ? '  → ' + extra : '')); } };
+const nuevaCfg = () => { const m = {}; return { cfg: m, all: () => ({ ...m }), set: (k, v) => { m[k] = String(v == null ? '' : v); } }; };
+const RAIZ = path.join(__dirname, '..');
+
+/* ── 1 · el instalador ya no lleva secretos ── */
+const licTxt = fs.readFileSync(path.join(RAIZ, 'electron', 'licencia.cjs'), 'utf8');
+t('1a. licencia.cjs no tiene SECRETO ni semilla TOTP global', !/const SECRETO\s*=/.test(licTxt) && !/TOTP_SECRET_B32/.test(licTxt) && !/secretoMascara\(m\) => crypto\.createHmac\('sha256', SECRETO/.test(licTxt));
+t('1b. las herramientas con el secreto desaparecieron del repo', ['generar-licencia.cjs', 'codigo-instalacion.cjs', 'codigo-renovacion.cjs'].every((f) => !fs.existsSync(path.join(RAIZ, 'tools', f))));
+t('1c. .gitignore no deja entrar las claves de Doel', /licencia-doel\.json/.test(fs.readFileSync(path.join(RAIZ, '.gitignore'), 'utf8')));
+t('1d. la clave de las copias DOELBAK1 sigue (solo lectura de lo antiguo) y es una constante derivada, no el secreto', /CLAVE_BAK = Buffer\.from\('[0-9a-f]{64}', 'hex'\)/.test(licTxt));
+
+/* ── 2 · claves de prueba y clave pública ── */
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'doel-lic-v2-'));
+lic.configurarClavePublica('');
+const c0 = nuevaCfg();
+t('2a. sin clave pública: demo lo dice (sinClavePublica) y activar lo explica', lic.estado(c0.all, c0.set).sinClavePublica === true
+  && (() => { try { lic.activar('DL2.x.y', c0.set, c0.all); return false; } catch (e) { return /clave pública/.test(e.message); } })());
+const k = LV2.claves({ dir });
+t('2b. claves() genera Ed25519 + maestra TOTP en la carpeta dada, con permisos 600', k.nueva && /BEGIN PUBLIC KEY/.test(k.publica) && /BEGIN PRIVATE KEY/.test(k.privada) && /^[0-9a-f]{64}$/.test(k.totp)
+  && (process.platform === 'win32' || (fs.statSync(LV2.rutaClaves(dir)).mode & 0o777) === 0o600));
+t('2c. una segunda llamada NO regenera (nueva:false, misma pública)', LV2.claves({ dir }).nueva === false && LV2.claves({ dir }).publica === k.publica);
+lic.configurarClavePublica(k.publica);
+const equipo = lic.equipoId();
+t('2d. el ID de equipo tiene el formato de siempre (AB12-CD34-EF56)', /^[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$/.test(equipo));
+
+/* ── 3 · el código DL2 ── */
+const dl2 = LV2.emitir({ dir, equipo, cliente: 'Taller de pruebas S.L.', modulos: 'crm,iso,kb', modo: 'permanente' });
+const p = lic.verificarDL2(dl2);
+t('3a. DL2.<datos>.<firma> verifica para este equipo y lleva cliente, módulos y semilla', /^DL2\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(dl2) && p && p.e === equipo && p.c === 'Taller de pruebas S.L.'
+  && p.m.join() === 'modulo_crm,modulo_iso,modulo_kb' && /^[A-Z2-7]{32}$/.test(p.s), JSON.stringify(p));
+t('3b. «todos» y «ninguno» como lista de módulos', lic.verificarDL2(LV2.emitir({ dir, equipo, cliente: 'X', modulos: 'todos' })).m.length === lic.MODULOS.length
+  && lic.verificarDL2(LV2.emitir({ dir, equipo, cliente: 'X', modulos: 'ninguno' })).m.length === 0);
+const otro = LV2.emitir({ dir, equipo: 'AAAA-BBBB-CCCC', cliente: 'Otro taller', modulos: 'todos' });
+t('3c. un código emitido para OTRO equipo no verifica aquí', lic.verificarDL2(otro) === null);
+const [pre, datos, firma] = dl2.split('.');
+const datosFalsos = Buffer.from(JSON.stringify({ ...p, m: lic.MODULOS.slice() })).toString('base64url');
+t('3d. cambiar los módulos dentro del código rompe la firma', lic.verificarDL2([pre, datosFalsos, firma].join('.')) === null);
+t('3e. cambiar un carácter de la firma lo invalida', lic.verificarDL2([pre, datos, (firma[0] === 'A' ? 'B' : 'A') + firma.slice(1)].join('.')) === null);
+t('3f. con la clave pública de OTRO Doel no verifica', (() => { const d2 = fs.mkdtempSync(path.join(os.tmpdir(), 'doel-lic-otro-')); const k2 = LV2.claves({ dir: d2 }); lic.configurarClavePublica(k2.publica); const r = lic.verificarDL2(dl2) === null; lic.configurarClavePublica(k.publica); return r; })());
+
+/* ── 4 · activar ── */
+const c1 = nuevaCfg();
+t('4a. antes de activar: demo', lic.estado(c1.all, c1.set).activada === false);
+const rAct = lic.activar(dl2, c1.set, c1.all);
+const e1 = lic.estado(c1.all, c1.set);
+t('4b. activar: estado activada v2 con cliente, módulos y sello v11', rAct.v2 === true && e1.activada && e1.v2 && e1.cliente === 'Taller de pruebas S.L.' && c1.cfg.licencia_sello_v === '11'
+  && c1.cfg.modulo_crm === '1' && c1.cfg.modulo_iso === '1' && c1.cfg.modulo_kb === '1' && c1.cfg.modulo_stock === '0' && c1.cfg.licencia_modo === 'permanente' && !c1.cfg.licencia_caduca);
+t('4c. la semilla duerme cifrada con la clave de instalación (v2:), no en claro', /^v2:/.test(c1.cfg.licencia_semilla) && !c1.cfg.licencia_semilla.includes(p.s)
+  && lic.semillaInstalacion(c1.all).length === 20 && lic.b32encode(lic.semillaInstalacion(c1.all)) === p.s);
+t('4d. activar con un código de otro equipo falla con el ID en el mensaje', (() => { try { lic.activar(otro, c1.set, c1.all); return false; } catch (e) { return e.message.includes(equipo); } })());
+const guardado = c1.cfg.modulo_kb;
+c1.set('modulo_kb', '0');
+t('4e. tocar un módulo a mano en la base → «manipulada»', lic.estado(c1.all, c1.set).manipulada === true);
+c1.set('modulo_kb', guardado);
+t('4f. …y al restaurarlo vuelve a estar activada', lic.estado(c1.all, c1.set).activada === true);
+c1.set('licencia_caduca', '2099-01-01');
+t('4g. alargar la caducidad a mano también rompe el sello', lic.estado(c1.all, c1.set).manipulada === true);
+c1.set('licencia_caduca', '');
+
+/* ── 5 · códigos cortos con la semilla de ESTA instalación ── */
+const cod6 = LV2.codigo({ dir, equipo });
+t('5a. el código de 6 dígitos de la herramienta vale aquí (totpValido) y el de otro equipo no', /^\d{6}$/.test(cod6) && lic.totpValido(cod6, c1.all) === true
+  && lic.totpValido(LV2.codigo({ dir, equipo: 'AAAA-BBBB-CCCC' }), c1.all) === false);
+t('5b. ±2 ventanas valen, ±3 no', lic.totpValido(LV2.codigo({ dir, equipo, contador: Math.floor(Date.now() / 1000 / 30) - 2 }), c1.all) && !lic.totpValido(LV2.codigo({ dir, equipo, contador: Math.floor(Date.now() / 1000 / 30) - 3 }), c1.all));
+const r6 = lic.activarConTotp(cod6, c1.set, c1.all);
+t('5c. en modo permanente el 6 dígitos confirma sin caducidad y re-sella', r6.activada && !r6.caduca && lic.estado(c1.all, c1.set).activada && c1.cfg.licencia_sello === lic.selloCalcular(c1.all()));
+t('5d. un 6 dígitos inventado se rechaza', (() => { try { lic.activarConTotp('000000', c1.set, c1.all); return false; } catch (e) { return /no válido|caducado/.test(e.message); } })());
+const cod12 = LV2.modulos({ dir, equipo, modulos: 'diagnostico,portal_taller' });
+const r12 = lic.activarConTotp(cod12, c1.set, c1.all);
+t('5e. el de 12 dígitos FIJA exactamente esos módulos (los demás a 0)', /^\d{6}-\d{6}$/.test(cod12) && r12.modulos.join() === 'modulo_portal_taller,modulo_diagnostico'
+  && c1.cfg.modulo_diagnostico === '1' && c1.cfg.modulo_portal_taller === '1' && c1.cfg.modulo_crm === '0' && lic.estado(c1.all, c1.set).activada);
+t('5f. el de 12 dígitos de OTRO equipo no vale aquí', (() => { try { lic.activarConTotp(LV2.modulos({ dir, equipo: 'AAAA-BBBB-CCCC', modulos: 'todos' }), c1.set, c1.all); return false; } catch (e) { return true; } })());
+t('5g. otpauth:// para enrolar el autenticador lleva la semilla en base32 y el ID de equipo', (() => { const u = LV2.qr({ dir, equipo }); return u.startsWith('otpauth://totp/Doel%20Taller:') && u.includes('secret=' + p.s) && u.includes(encodeURIComponent(equipo)); })());
+
+/* ── 6 · mensual: cada código da 31 días ── */
+const c2 = nuevaCfg();
+lic.activar(LV2.emitir({ dir, equipo, cliente: 'Mensual', modulos: 'ninguno', modo: 'mensual' }), c2.set, c2.all);
+const hoyMas31 = new Date(Date.now() + 31 * 86400000).toISOString().slice(0, 10);
+t('6a. activar en modo mensual deja caducidad a +31 días', c2.cfg.licencia_modo === 'mensual' && c2.cfg.licencia_caduca === hoyMas31 && lic.estado(c2.all, c2.set).caduca === hoyMas31);
+c2.set('licencia_caduca', '2020-01-01'); lic.sellar(c2.all, c2.set);
+t('6b. caducada → bloqueada', lic.estado(c2.all, c2.set).caducada === true && lic.estado(c2.all, c2.set).bloqueada === true);
+lic.activarConTotp(LV2.codigo({ dir, equipo }), c2.set, c2.all);
+t('6c. el 6 dígitos renueva +31 y desbloquea', c2.cfg.licencia_caduca === hoyMas31 && lic.estado(c2.all, c2.set).activada === true);
+const c3 = nuevaCfg();
+lic.activar(LV2.emitir({ dir, equipo, cliente: 'Fija', modulos: 'crm', modo: 'anual', caduca: '2031-06-30' }), c3.set, c3.all);
+t('6d. --caduca fija la fecha exacta', c3.cfg.licencia_caduca === '2031-06-30' && c3.cfg.licencia_modo === 'anual');
+
+/* ── 7 · migración de una activación anterior a la 0.1.74 ── */
+const c4 = nuevaCfg();
+c4.set('activacion_hmac', 'HASH-DE-LA-EPOCA-ANTERIOR'); c4.set('licencia_sello_v', '10'); c4.set('licencia_sello', 'sello-viejo-ilegible');
+c4.set('modulo_crm', '1'); c4.set('licencia_modo', 'permanente');
+const e4 = lic.estado(c4.all, c4.set);
+t('7a. una instalación activada antes sigue activada (heredada, necesitaDL2) y se re-sella en v11', e4.activada === true && e4.legado === true && e4.necesitaDL2 === true
+  && c4.cfg.licencia_sello_v === '11' && c4.cfg.licencia_legado === '1' && c4.cfg.modulo_crm === '1');
+c4.set('modulo_iso', '1');
+t('7b. tocar un módulo después de la migración → manipulada (el sello nuevo manda)', lic.estado(c4.all, c4.set).manipulada === true);
+c4.set('modulo_iso', '');
+t('7c. sin DL2 los códigos cortos no valen y el mensaje dice qué pedir', (() => { try { lic.activarConTotp(LV2.codigo({ dir, equipo }), c4.set, c4.all); return false; } catch (e) { return /DL2/.test(e.message) && e.message.includes(equipo); } })()
+  && lic.totpValido(LV2.codigo({ dir, equipo }), c4.all) === false);
+lic.activar(LV2.emitir({ dir, equipo, cliente: 'Migrado', modulos: 'crm,iso' }), c4.set, c4.all);
+const e4b = lic.estado(c4.all, c4.set);
+t('7d. al pegar su DL2 pasa a v2: deja de ser heredada y los códigos cortos ya funcionan', e4b.v2 === true && !e4b.legado && !c4.cfg.licencia_legado && !c4.cfg.activacion_hmac
+  && lic.totpValido(LV2.codigo({ dir, equipo }), c4.all) === true);
+const c5 = nuevaCfg();
+c5.set('licencia_codigo', 'eyJjIjoiWCJ9.firmavieja');
+t('7e. la licencia firmada antigua (con punto) también cuenta como heredada', lic.estado(c5.all, c5.set).legado === true);
+
+/* ── 8 · lo que lo rodea: main.cjs, pantallas, check-puente ── */
+const main = fs.readFileSync(path.join(RAIZ, 'electron', 'main.cjs'), 'utf8');
+const ruta = /handle\('licencia:activar'[\s\S]*?\n  \}\);/.exec(main)[0];
+const expr = /return ([\s\S]*?);\s*\}\);\s*$/.exec(ruta)[1];
+const decide = new Function('c', 'return (' + expr.replace('licencia.activarConTotp(c, db.configSet, db.configAll)', "'corto'").replace('licencia.activar(c, db.configSet, db.configAll)', "'dl2'") + ');');
+t('8a. main.cjs: 6 y 12 dígitos van por el código corto; el DL2 (con puntos) por activar', decide('123456') === 'corto' && decide('008192-552296') === 'corto' && decide('DL2.abc.def') === 'dl2');
+t('8b. main.cjs: el Panel Dev se abre con el TOTP de ESTA instalación y explica si falta el DL2', /licencia\.totpValido\(codigo, db\.configAll\)/.test(main) && /semillaInstalacion\(db\.configAll\)/.test(main));
+t('8c. main.cjs: config:set re-sella con la lista de claves del sello v11 y desactivar limpia el DL2', /licencia\.SELLO_CLAVES\.includes\(clave\)/.test(main) && /configSet\('licencia_v2', ''\)/.test(main));
+const sistema = fs.readFileSync(path.join(RAIZ, 'src', 'components', 'ajustes', 'sistema.jsx'), 'utf8');
+const app = fs.readFileSync(path.join(RAIZ, 'src', 'App.jsx'), 'utf8');
+t('8d. Ajustes → Licencia y la pantalla de activación admiten pegar el DL2 y avisan si la activación es heredada', /DL2\./.test(sistema) && /necesitaDL2/.test(sistema) && /DL2\./.test(app));
+const puente = fs.readFileSync(path.join(RAIZ, 'tools', 'check-puente.cjs'), 'utf8');
+t('8e. check-puente avisa si la compilación no lleva la clave pública de Doel', /CLAVE_PUBLICA_DOEL/.test(puente));
+t('8f. el manual explica el DL2 y los códigos por teléfono', /DL2/.test(fs.readFileSync(path.join(RAIZ, 'MANUAL.md'), 'utf8')));
+
+console.log(`\n${ko === 0 ? '✅' : '❌'}  Licencia v2 (DL2 + semilla por instalación): ${ok} OK · ${ko} fallos`);
