+/* v0.1.78 · punto 5 del plan · el permiso por canal también se comprueba en el mostrador (IPC), con la sesión local.
+   1 · la regla, en seco   2 · con la base de verdad (perfil vivo)   3 · el cableado en main.cjs, canales.cjs y la pantalla */
+const fs = require('fs'); const os = require('os'); const path = require('path');
+process.chdir(path.resolve(__dirname, '..'));
+let ok = 0, ko = 0;
+const t = (n, cond, det) => { if (cond) { ok++; console.log('  OK  ' + n); } else { ko++; console.log('  ✗   ' + n + (det ? '\n        ' + det : '')); } };
+const S = require('../electron/sesion-local.cjs');
+
+console.log('1 · La regla');
+S.salir();
+t('1a. sin nadie dentro, lo que no exige permiso pasa (config:all, licencia:estado, taller:orden-crear, auth:login)', ['config:all', 'licencia:estado', 'empresa:get', 'taller:orden-crear', 'auth:login', 'fichaje:fichar'].every((c) => S.autoriza(c) === null));
+t('1b. sin nadie dentro, lo que exige permiso no pasa y lo dice', /Entra con tu PIN/.test(S.autoriza('config:set')) && /Entra con tu PIN/.test(S.autoriza('usuarios:save')) && /Entra con tu PIN/.test(S.autoriza('dev:acceso')));
+t('1c. …salvo activar la licencia: la app está bloqueada y no hay con quién entrar', S.autoriza('licencia:activar') === null && S.SIN_SESION.size === 1);
+S.entrar({ id: 7, nombre: 'Paco', rol: 'camarero', permisos: { ajustes: false, compras: false, inventario: true } });
+t('1d. un técnico (sin ajustes ni compras) → config:set y compras:aplicar negados con el nombre del permiso; artículos sí', /permiso «ajustes»/.test(S.autoriza('config:set')) && /permiso «compras»/.test(S.autoriza('compras:aplicar')) && S.autoriza('catalogo:saveProducto') === null && S.autoriza('taller:orden-crear') === null);
+S.entrar({ id: 1, nombre: 'Edmundo', rol: 'admin', permisos: null });
+t('1e. un administrador sin perfil (permisos null) pasa por rol', S.autoriza('config:set') === null && S.autoriza('dev:renovar') === null);
+S.entrar({ id: 2, nombre: 'Juan', rol: 'camarero', permisos: null });
+t('1f. un usuario sin perfil que no es admin solo hace lo que no exige permiso', /permiso «ajustes»/.test(S.autoriza('config:set')) && S.autoriza('tickets:crear') === null);
+t('1g. entrar con null (PIN malo) deja la sesión vacía y salir() la cierra', S.entrar(null) === null && S.actual() === null && (S.entrar({ id: 3, nombre: 'X', rol: 'admin' }), S.salir(), S.actual() === null));
+
+console.log('\n2 · Con la base de verdad: el perfil se relee en cada llamada');
+const dir = path.join(os.tmpdir(), 'doel-test-permisos-ipc'); fs.rmSync(dir, { recursive: true, force: true }); fs.mkdirSync(dir, { recursive: true });
+const db = require('../electron/db.cjs'); db.init(dir);
+const perfiles = db.listPerfiles(); const tecnico = perfiles.find((p) => p.nombre === 'Técnico'), admin = perfiles.find((p) => p.nombre === 'Administrador');
+db.saveUsuario({ nombre: 'Paco Técnico', pin: '7777', perfil_id: tecnico.id });
+const u = db.login('7777', { frenoLocal: true });
+S.entrar(u);
+t('2a. el técnico entra por db.login y la sesión local lo recuerda', !!u && S.actual().nombre === 'Paco Técnico' && S.actual().permisos.ajustes === false);
+t('2b. config:set negado; catalogo:saveProducto permitido', /ajustes/.test(S.autoriza('config:set', db)) && S.autoriza('catalogo:saveProducto', db) === null);
+db.saveUsuario({ id: u.id, nombre: 'Paco Técnico', perfil_id: admin.id });
+t('2c. le cambian el perfil a Administrador → en la siguiente llamada ya puede, sin salir y entrar', S.autoriza('config:set', db) === null && S.actual().permisos.ajustes === true);
+db.usuarioBaja(u.id, 1);
+const baja = S.autoriza('config:set', db);
+t('2d. lo dan de baja → «Tu usuario ya no está activo» y la sesión se cierra', /ya no está activo/.test(String(baja)) && S.actual() === null, String(baja));
+t('2e. sin sesión, lo libre sigue pasando con la base delante', S.autoriza('config:all', db) === null);
+
+console.log('\n3 · El cableado');
+const main = fs.readFileSync('electron/main.cjs', 'utf8');
+const C = require('../electron/canales.cjs');
+t('3a. handle() pregunta a la sesión local en el camino IPC (ipcMain.handle), no en HANDLERS (el puesto en red tiene el suyo)', (() => { const i = main.indexOf('ipcMain.handle(canal, async (_e, ...args) => {'); const j = main.indexOf('HANDLERS.set(canal, async (...args) => {'); const k = main.indexOf('const no = sesionLocal.autoriza(canal, db);'); return i > 0 && j > 0 && k > i && !(k > j && k < i); })());
+t('3b. la negativa se apunta en el registro y llega a la pantalla como error', /db\.logEvento\('mostrador', 'Denegado ' \+ canal/.test(main) && /throw new Error\(no\)/.test(main));
+t('3c. auth:login (IPC) abre la sesión, auth:logout la cierra, auth:verificar solo comprueba el PIN', /handle\('auth:login', \(pin\) => db\.login\(pin\), \(pin\) => sesionLocal\.entrar\(db\.login\(pin, \{ frenoLocal: true \}\)\)\)/.test(main) && /handle\('auth:logout', \(\) => true, \(\) => \{ sesionLocal\.salir\(\); return true; \}\)/.test(main) && /handle\('auth:verificar', \(pin\) => db\.login\(pin\), \(pin\) => db\.login\(pin, \{ frenoLocal: true \}\)\)/.test(main));
+t('3d. auth:verificar está en la tabla con PIN (freno por IP en el puesto en red) y sin permiso, y el preload lo expone', C.CANALES['auth:verificar'] && C.CANALES['auth:verificar'].pin === true && !C.CANALES['auth:verificar'].permiso && C.PIN.has('auth:verificar') && /verificar: call\('auth:verificar'\)/.test(fs.readFileSync('electron/preload.cjs', 'utf8')));
+const tpv = fs.readFileSync('src/components/TPV.jsx', 'utf8'), login = fs.readFileSync('src/components/Login.jsx', 'utf8');
+t('3e. el TPV comprueba quién abre la caja con auth.verificar (no cambia de usuario); la pantalla de entrada sigue con auth.login', /api\.auth\.verificar\(pin\)/.test(tpv) && !/api\.auth\.login\(/.test(tpv) && /api\.auth\.login\(/.test(login));
+t('3f. el puesto en red no se ve afectado: /rpc sigue usando HANDLERS (fn0) y su propia sesión', /const fn = HANDLERS\.get\(canal\);/.test(fs.readFileSync('electron/puesto-red.cjs', 'utf8')) && !/sesionLocal/.test(fs.readFileSync('electron/puesto-red.cjs', 'utf8')));
+t('3g. la regla es la misma que la del puesto en red: permisos-canal.autorizado', /permisos\.autorizado\(sesion, canal\)/.test(fs.readFileSync('electron/sesion-local.cjs', 'utf8')));
+
+console.log(`\n${ko === 0 ? '✅' : '❌'}  Permisos por canal en IPC: ${ok} OK · ${ko} fallos`);
+process.exit(ko === 0 ? 0 : 1);
