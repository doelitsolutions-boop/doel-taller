+   https se abren en el navegador del sistema y el resto se niega. */
+function endurecerVentana(w) {
+  const wc = w.webContents;
+  wc.setWindowOpenHandler(({ url }) => {
+    if (/^https:\/\//.test(url)) { try { shell.openExternal(url); } catch (e) { /* sin navegador: nada */ } }
+    return { action: 'deny' };
