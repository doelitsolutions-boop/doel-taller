@@ -25,12 +25,68 @@ const dentroDe = (ms) => isoLocal(new Date(Date.now() + ms));
 const sha256 = (s) => crypto.createHash('sha256').update(s, 'utf8').digest('hex').toUpperCase();
 const pinHash = (pin) => sha256(SALT + ':' + pin);
 
+/* v0.1.73 · SEC-10 · PIN con scrypt y SAL POR USUARIO.
+   Hasta la 0.1.72 el PIN de `usuarios` era sha256(SAL_FIJA:pin) y el de `fichaje_empleados` y el admin
+   de fichaje sha256(pin) a secas: con una copia de la base (o un .doelbak) se recuperaban TODOS los PIN
+   con una tabla de 10 000 hashes en menos de un segundo. Ahora cada PIN lleva su sal y scrypt
+   (N=2^13: ~15 ms por comprobación, imperceptible al teclear; 10 000 intentos ya no son gratis).
+   Formato guardado: «s1$<sal hex>$<hash hex>». Los hashes antiguos se siguen reconociendo y se
+   reescriben al formato nuevo la primera vez que el PIN entra bien (migración perezosa): nadie tiene
+   que volver a teclear nada. */
+const PIN_SCRYPT = { N: 8192, r: 8, p: 1, maxmem: 32 * 1024 * 1024 };
+const pinHashNuevo = (pin) => {
+  const sal = crypto.randomBytes(16).toString('hex');
+  return 's1$' + sal + '$' + crypto.scryptSync(String(pin), sal, 32, PIN_SCRYPT).toString('hex');
+};
+/* ¿Casa este PIN con este hash? Devuelve { ok, legado } (legado = hash antiguo que conviene reescribir). */
+const pinCoincide = (pin, hash) => {
+  const p = String(pin == null ? '' : pin); const h = String(hash || '');
+  if (!h) return { ok: false, legado: false };
+  if (h.startsWith('s1$')) {
+    const [, sal, esperado] = h.split('$');
+    const calc = crypto.scryptSync(p, sal || '', 32, PIN_SCRYPT).toString('hex');
+    const a = Buffer.from(calc, 'hex'); const b = Buffer.from(esperado || '', 'hex');
+    return { ok: a.length === b.length && crypto.timingSafeEqual(a, b), legado: false };
+  }
+  const H = h.toUpperCase();
+  return { ok: H === pinHash(p) || H === sha256(p), legado: true };
+};
+/* Busca en `tabla` (usuarios | fichaje_empleados) la fila activa cuyo PIN es este, probando una por una
+   (el PIN entra sin usuario, así que no hay otra forma con sal por fila; son decenas de filas, no miles).
+   Si la fila aún lleva un hash antiguo, lo reescribe. Devuelve el id o null. */
+const buscarPorPin = (tabla, pin) => {
+  if (tabla !== 'usuarios' && tabla !== 'fichaje_empleados') throw new Error('Tabla de PIN no válida');
+  const filas = conexion.prepare(`SELECT id, pin_hash FROM ${tabla} WHERE activo = 1`).all();
+  for (const f of filas) {
+    const r = pinCoincide(pin, f.pin_hash);
+    if (!r.ok) continue;
+    if (r.legado) { try { conexion.prepare(`UPDATE ${tabla} SET pin_hash = ? WHERE id = ?`).run(pinHashNuevo(pin), f.id); } catch (e) { /* se reintenta en el próximo login */ } }
+    return f.id;
+  }
+  return null;
+};
+/* Freno local del PIN (el del puesto en red vive en seguridad-lan.cjs y va por IP; este es el del
+   propio mostrador, donde hasta ahora se podían probar los 10 000 sin que nadie lo notara).
+   Cinco fallos seguidos → 5 minutos sin aceptar PIN; un acierto borra el historial. */
+const FRENO_PIN = { fallos: [], tope: 5, ventanaMs: 5 * 60 * 1000 };
+const frenoPin = {
+  bloqueo(ahora = Date.now()) {
+    FRENO_PIN.fallos = FRENO_PIN.fallos.filter((t) => ahora - t < FRENO_PIN.ventanaMs);
+    if (FRENO_PIN.fallos.length < FRENO_PIN.tope) return null;
+    return Math.max(1, Math.ceil((FRENO_PIN.ventanaMs - (ahora - FRENO_PIN.fallos[0])) / 1000));
+  },
+  fallo(ahora = Date.now()) { FRENO_PIN.fallos.push(ahora); },
+  acierto() { FRENO_PIN.fallos = []; },
+  olvidar() { FRENO_PIN.fallos = []; },
+};
+
 const N = {
   API: {},                                   // registro: cada módulo se apunta aquí
   get db() { return conexion; },             // la conexión, tal cual la usaban las funciones
   abrir(rutaFichero) { conexion = new Database(rutaFichero); return conexion; },
   Database, crypto, fs, path,
   SALT, r2, nowISO, isoLocal, dentroDe, sha256, pinHash,
+  pinHashNuevo, pinCoincide, buscarPorPin, frenoPin, // v0.1.73 · SEC-10
 };
 
