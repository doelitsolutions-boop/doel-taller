+#!/usr/bin/env node
+/* HERRAMIENTA PRIVADA DE DOEL IT SOLUTIONS — NO VA EN EL INSTALADOR (package.json: !tools/**)
+   Licencias v2 (0.1.74): la clave privada vive SOLO en el PC de Doel, en ~/.doel/licencia-doel.json
+   (o en la carpeta de la variable DOEL_LICENCIA_DIR). La app lleva únicamente la clave pública.
+
+   Uso:
+     node tools/licencia-v2.cjs claves                       genera las claves (una vez) y escribe la pública en electron/licencia.cjs
+     node tools/licencia-v2.cjs emitir --equipo AB12-CD34-EF56 --cliente "Taller X" [--modulos crm,iso,kb,diagnostico | todos | ninguno] [--modo permanente|mensual|anual] [--caduca 2027-12-31]
+     node tools/licencia-v2.cjs codigo  --equipo AB12-CD34-EF56                     código de 6 dígitos (renovación / Panel Dev) de ESE equipo, ahora mismo
+     node tools/licencia-v2.cjs modulos --equipo AB12-CD34-EF56 --modulos crm,iso    código de 12 dígitos que fija esos módulos en ESE equipo
+     node tools/licencia-v2.cjs qr      --equipo AB12-CD34-EF56                     otpauth:// para enrolar ESE equipo en un autenticador (una entrada por cliente)
+
+   El ID de equipo lo lee el cliente en Ajustes → Sistema → Licencia (o en la pantalla de activación).
+   El código DL2 se le manda por WhatsApp o correo y lo pega una vez; los cortos se dictan por teléfono. */
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const os = require('os');
+const lic = require('../electron/licencia.cjs');
+
+const DIR_DEFECTO = () => process.env.DOEL_LICENCIA_DIR || path.join(os.homedir(), '.doel');
+const rutaClaves = (dir) => path.join(dir || DIR_DEFECTO(), 'licencia-doel.json');
+const RE_EQUIPO = /^[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$/;
+
+/* Genera (o lee, si ya existen) las claves de Doel: par Ed25519 + clave maestra de semillas TOTP. */
+function claves({ dir = DIR_DEFECTO(), forzar = false } = {}) {
+  const ruta = rutaClaves(dir);
+  if (fs.existsSync(ruta) && !forzar) return { ...JSON.parse(fs.readFileSync(ruta, 'utf8')), ruta, nueva: false };
+  const { publicKey, privateKey } = crypto.generateKeyPairSync('ed25519');
+  const k = {
+    formato: 1,
+    publica: publicKey.export({ type: 'spki', format: 'pem' }),
+    privada: privateKey.export({ type: 'pkcs8', format: 'pem' }),
+    totp: crypto.randomBytes(32).toString('hex'), // maestra de la que salen las semillas por equipo
+    creado: new Date().toISOString(),
+  };
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(ruta, JSON.stringify(k, null, 2), { mode: 0o600 });
+  return { ...k, ruta, nueva: true };
+}
+function leer(dir) {
+  const ruta = rutaClaves(dir);
+  if (!fs.existsSync(ruta)) throw new Error('No hay claves de Doel en ' + ruta + '. Primero: node tools/licencia-v2.cjs claves');
+  return JSON.parse(fs.readFileSync(ruta, 'utf8'));
+}
+
+/* Semilla TOTP de un equipo: determinista a partir de la maestra, así no hace falta guardar un registro
+   por cliente; el mismo ID de equipo da siempre la misma semilla. 20 bytes (160 bits, SHA-1 TOTP). */
+function semillaDe(equipo, dir) {
+  const e = String(equipo || '').trim().toUpperCase();
+  if (!RE_EQUIPO.test(e)) throw new Error('ID de equipo con formato raro: ' + equipo + ' (esperaba AB12-CD34-EF56)');
+  const k = leer(dir);
+  return crypto.createHmac('sha256', Buffer.from(k.totp, 'hex')).update('semilla|' + e).digest().subarray(0, 20);
+}
+
+function normalizarModulos(v) {
+  if (Array.isArray(v)) return v.map((m) => (m.startsWith('modulo_') ? m : 'modulo_' + m)).filter((m) => lic.MODULOS.includes(m));
+  const s = String(v || '').trim().toLowerCase();
+  if (!s || s === 'ninguno') return [];
+  if (s === 'todos') return [...lic.MODULOS];
+  return normalizarModulos(s.split(/[\s,;]+/).filter(Boolean));
+}
+
+/* El código DL2: lo que el cliente pega una vez. */
+function emitir({ dir, equipo, cliente, modulos = [], modo = 'permanente', caduca = null } = {}) {
+  const e = String(equipo || '').trim().toUpperCase();
+  if (!RE_EQUIPO.test(e)) throw new Error('ID de equipo con formato raro: ' + equipo);
+  if (!String(cliente || '').trim()) throw new Error('Falta --cliente');
+  if (!['permanente', 'mensual', 'anual'].includes(modo)) throw new Error('--modo: permanente | mensual | anual');
+  if (caduca && !/^\d{4}-\d{2}-\d{2}$/.test(caduca)) throw new Error('--caduca: AAAA-MM-DD');
+  const k = leer(dir);
+  const payload = { v: 2, e, c: String(cliente).trim().slice(0, 120), m: normalizarModulos(modulos), modo, h: caduca || null,
+    s: lic.b32encode(semillaDe(e, dir)), t: new Date().toISOString().slice(0, 10) };
+  const datos = Buffer.from(JSON.stringify(payload), 'utf8');
+  const firma = crypto.sign(null, Buffer.concat([Buffer.from('DL2|'), datos]), crypto.createPrivateKey(k.privada));
+  return 'DL2.' + datos.toString('base64url') + '.' + firma.toString('base64url');
+}
+
+const codigo = ({ dir, equipo, contador } = {}) => lic.codigoRenovacion(semillaDe(equipo, dir), contador);
+const modulos = ({ dir, equipo, modulos: m, contador } = {}) => lic.codigoModulosSeguro(lic.mascaraDeModulos(normalizarModulos(m)), semillaDe(equipo, dir), contador);
+const qr = ({ dir, equipo } = {}) => lic.otpauthUri(String(equipo).trim().toUpperCase(), semillaDe(equipo, dir));
+
+/* Escribe la clave pública en electron/licencia.cjs (la app se recompila después). */
+function escribirPublicaEnApp({ dir, raiz = path.join(__dirname, '..') } = {}) {
+  const k = leer(dir);
+  const ruta = path.join(raiz, 'electron', 'licencia.cjs');
+  const t = fs.readFileSync(ruta, 'utf8');
+  const re = /let CLAVE_PUBLICA_DOEL = `[\s\S]*?`;/;
+  if (!re.test(t)) throw new Error('No encuentro CLAVE_PUBLICA_DOEL en ' + ruta);
+  fs.writeFileSync(ruta, t.replace(re, 'let CLAVE_PUBLICA_DOEL = `' + k.publica.trim() + '`;'));
+  return ruta;
+}
+
+module.exports = { claves, leer, semillaDe, emitir, codigo, modulos, qr, escribirPublicaEnApp, normalizarModulos, rutaClaves };
+
+if (require.main === module) {
+  const [orden, ...resto] = process.argv.slice(2);
+  const arg = (n) => { const i = resto.indexOf('--' + n); return i >= 0 ? resto[i + 1] : undefined; };
+  const seg = () => 30 - (Math.floor(Date.now() / 1000) % 30);
+  try {
+    if (orden === 'claves') {
+      const k = claves({ forzar: resto.includes('--forzar') });
+      const r = escribirPublicaEnApp({});
+      console.log(k.nueva ? '\nClaves NUEVAS generadas en ' + k.ruta : '\nClaves ya existentes en ' + k.ruta);
+      console.log('Clave pública escrita en ' + r + ' → recompila la app (npm run dist) para que la lleve.');
+      console.log('GUARDA ' + k.ruta + ' a buen recaudo (copia fuera del PC): sin ella no se emiten licencias ni códigos.\n');
+    } else if (orden === 'emitir') {
+      const c = emitir({ equipo: arg('equipo'), cliente: arg('cliente'), modulos: arg('modulos') || [], modo: arg('modo') || 'permanente', caduca: arg('caduca') || null });
+      console.log('\nCódigo de activación DL2 para ' + arg('equipo').toUpperCase() + ' (' + arg('cliente') + '):\n\n' + c + '\n');
+      console.log('Mándaselo entero (WhatsApp/correo); se pega en Ajustes → Sistema → Licencia una sola vez.\n');
+    } else if (orden === 'codigo') {
+      const t = Math.floor(Date.now() / 1000 / 30);
+      console.log('\nCódigo de 6 dígitos para ' + arg('equipo').toUpperCase() + ':  ' + codigo({ equipo: arg('equipo'), contador: t }) + '   (caduca en ' + seg() + ' s; el siguiente será ' + codigo({ equipo: arg('equipo'), contador: t + 1 }) + ')\n');
+    } else if (orden === 'modulos') {
+      const lista = normalizarModulos(arg('modulos') || '');
+      console.log('\nMódulos que quedarán activos: ' + (lista.length ? lista.map((m) => m.replace('modulo_', '')).join(' · ') : '(ninguno)'));
+      console.log('Código de 12 dígitos para ' + arg('equipo').toUpperCase() + ':  ' + modulos({ equipo: arg('equipo'), modulos: lista }) + '   (caduca en ' + seg() + ' s)\n');
+    } else if (orden === 'qr') {
+      console.log('\n' + qr({ equipo: arg('equipo') }) + '\n\nPégalo en un generador de QR y escanéalo con el autenticador: una entrada por cliente.\n');
+    } else {
+      console.log(fs.readFileSync(__filename, 'utf8').split('*/')[0].replace(/^\/\*\s?/, ''));
+      process.exit(orden ? 1 : 0);
+    }
+  } catch (e) { console.error('\n✗ ' + e.message + '\n'); process.exit(1); }
+}
