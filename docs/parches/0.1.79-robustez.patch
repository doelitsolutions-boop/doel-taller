diff --git a/electron/robustez.cjs b/electron/robustez.cjs
new file mode 100644
index 0000000..2b048e7
--- /dev/null
+++ b/electron/robustez.cjs
@@ -0,0 +1,59 @@
+/* v0.1.79 · punto 6 del plan · Robustez del quiosco, lado del proceso principal.
+   1 · `sistema:error-pantalla`: la pantalla (ErrorBoundary por vista, window.onerror, promesas sin catch) manda
+       el fallo y aquí se apunta en el registro del mostrador (tipo «pantalla»), con tope y sin repetidos.
+   2 · Si el proceso de la ventana MUERE (render-process-gone: sin memoria, fallo de GPU, un driver) o se queda
+       colgado (unresponsive), hasta ahora el mostrador se quedaba en blanco hasta que alguien mataba el
+       programa. Ahora se apunta y se recarga la ventana; si muere tres veces en cinco minutos, se deja de
+       recargar y se avisa (algo más gordo pasa: driver, disco, RAM). */
+const MAX_POR_VENTANA = 40;      // errores de pantalla apuntados por cada 10 minutos
+const VENTANA_MS = 10 * 60000;
+const REPETIDO_MS = 60000;
+const CAIDAS_MAX = 3;
+const CAIDAS_VENTANA_MS = 5 * 60000;
+
+const estado = { desde: 0, apuntados: 0, vistos: new Map(), caidas: [] };
+
+function registrarErrorPantalla(db, info, ahora = Date.now()) {
+  if (!info || typeof info !== 'object') return { ok: false, motivo: 'sin datos' };
+  const vista = String(info.vista || '?').slice(0, 60);
+  const mensaje = String(info.mensaje || 'error sin mensaje').replace(/\s+/g, ' ').slice(0, 400);
+  const pila = String(info.pila || '').split('\n').map((l) => l.trim()).filter(Boolean).slice(0, 4).join(' ← ').slice(0, 500);
+  if (ahora - estado.desde > VENTANA_MS) { estado.desde = ahora; estado.apuntados = 0; estado.vistos.clear(); }
+  const clave = vista + '|' + mensaje;
+  const ultimo = estado.vistos.get(clave);
+  if (ultimo != null && ahora - ultimo < REPETIDO_MS) return { ok: true, apuntado: false, motivo: 'repetido' };
+  if (estado.apuntados >= MAX_POR_VENTANA) return { ok: true, apuntado: false, motivo: 'tope' };
+  estado.vistos.set(clave, ahora); estado.apuntados++;
+  try { db.logEvento('pantalla', vista + ': ' + mensaje + (pila ? ' · ' + pila : '')); } catch (e) { return { ok: false, motivo: e.message }; }
+  return { ok: true, apuntado: true };
+}
+
+/* Qué hacer cuando la ventana muere: devuelve 'recargar' o 'parar' (y por qué), para que vigilarVentana lo haga
+   y la batería lo compruebe sin Electron. */
+function decidirTrasCaida(ahora = Date.now()) {
+  estado.caidas = estado.caidas.filter((t) => ahora - t < CAIDAS_VENTANA_MS);
+  estado.caidas.push(ahora);
+  return estado.caidas.length >= CAIDAS_MAX ? 'parar' : 'recargar';
+}
+
+function vigilarVentana(win, db) {
+  const log = (d) => { try { db.logEvento('pantalla', d); } catch (e) { /* base cerrada: nada */ } };
+  win.webContents.on('render-process-gone', (_e, det) => {
+    const motivo = det && det.reason ? det.reason + (det.exitCode != null ? ' (' + det.exitCode + ')' : '') : 'desconocido';
+    const que = decidirTrasCaida();
+    log('La ventana se ha caído: ' + motivo + ' → ' + (que === 'recargar' ? 'se recarga' : 'tres caídas en cinco minutos: no se recarga más'));
+    if (que === 'recargar') { setTimeout(() => { try { if (!win.isDestroyed()) win.webContents.reload(); } catch (e) { /* nada */ } }, 800); return; }
+    try {
+      require('electron').dialog.showMessageBox(win, { type: 'error', title: 'Doel Taller — la pantalla se cae repetidamente',
+        message: 'La ventana se ha caído tres veces en cinco minutos (' + motivo + ').',
+        detail: 'Suele ser el controlador de vídeo, la memoria o el disco. Cierra el programa, reinicia el PC y, si sigue, avisa a Doel. El registro de eventos tiene el detalle.' });
+    } catch (e) { /* sin diálogo: ya está apuntado */ }
+  });
+  win.webContents.on('unresponsive', () => log('La ventana no responde (colgada más de 30 s)'));
+  win.webContents.on('responsive', () => log('La ventana vuelve a responder'));
+}
+
+/* para la batería */
+function _reiniciar() { estado.desde = 0; estado.apuntados = 0; estado.vistos.clear(); estado.caidas = []; }
+
+module.exports = { registrarErrorPantalla, decidirTrasCaida, vigilarVentana, MAX_POR_VENTANA, REPETIDO_MS, CAIDAS_MAX, CAIDAS_VENTANA_MS, _reiniciar };
