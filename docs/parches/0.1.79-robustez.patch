+import React from 'react';
+import { api } from '../api.js';
+
+/* v0.1.79 · punto 6 del plan · Límite de error POR VISTA.
+   Hasta ahora el único ErrorBoundary estaba en main.jsx, alrededor de toda la App: un `.map` sobre undefined en
+   Informes tiraba la barra lateral, el TPV y la orden a medio escribir, y el único botón era «Reiniciar». Ahora
+   cada vista va dentro de esto (App.jsx lo monta con `key={vista}`, así cambiar de pantalla lo deja limpio): el
+   fallo se queda en su pantalla, se apunta en el registro del mostrador (`sistema:error-pantalla`, con vista,
+   mensaje y pila) y el técnico puede reintentar, volver al inicio o, si no hay otra, reiniciar. */
+export default class LimiteVista extends React.Component {
+  constructor(props) { super(props); this.state = { error: null, intentos: 0 }; }
+  static getDerivedStateFromError(error) { return { error }; }
+  componentDidCatch(error, info) {
+    try {
+      const f = api && api.sistema && api.sistema.errorPantalla;
+      if (f) f({ vista: String(this.props.vista || '?'), mensaje: String((error && error.message) || error), pila: String((error && error.stack) || '').slice(0, 1500), componente: String((info && info.componentStack) || '').slice(0, 600) }).catch(() => { /* sin puente: nada */ });
+    } catch (e) { /* informar nunca puede fallar más fuerte que el propio fallo */ }
+  }
+  render() {
+    if (!this.state.error) return <React.Fragment key={this.state.intentos}>{this.props.children}</React.Fragment>;
+    const msg = String((this.state.error && this.state.error.message) || this.state.error);
+    return (
+      <div className="limite-vista" style={{ padding: 32, maxWidth: 760, color: '#f2f7fb' }}>
+        <h2 style={{ color: '#e05252', marginTop: 0 }}>Esta pantalla ha fallado</h2>
+        <p style={{ margin: '10px 0' }}>El resto del programa sigue funcionando. El fallo ha quedado apuntado en el registro para que Doel lo vea.</p>
+        <pre style={{ fontSize: 12, color: '#9db4c6', whiteSpace: 'pre-wrap', background: '#061f36', padding: 10, borderRadius: 8 }}>{msg}</pre>
+        <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap' }}>
+          <button className="btn" onClick={() => this.setState((s) => ({ error: null, intentos: s.intentos + 1 }))}>↻ Reintentar</button>
+          {this.props.onSalir && <button className="btn" onClick={this.props.onSalir}>🏠 Volver al inicio</button>}
+          <button className="btn" onClick={() => window.location.reload()}>Reiniciar aplicación</button>
+        </div>
+      </div>
+    );
+  }
+}
