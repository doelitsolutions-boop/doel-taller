+/* v0.1.79 · punto 6 del plan · Errores del renderer que NO pasan por un ErrorBoundary: excepciones en manejadores
+   de eventos, en setTimeout y promesas rechazadas sin catch. Hasta ahora morían en la consola de una ventana sin
+   DevTools: nadie se enteraba. Se mandan al proceso principal (`sistema:error-pantalla`), que los apunta en el
+   registro. Sin repetir el mismo fallo cada segundo (un setInterval roto) ni sin tope (un bucle): el mismo
+   vista+mensaje se manda una vez por minuto, y como mucho TOPE por sesión de pantalla. */
+export const TOPE = 30;
+export const VENTANA_MS = 60000;
+
+export function crearInformador(enviar, ahora = () => Date.now()) {
+  const vistos = new Map(); // clave → último envío
+  let enviados = 0;
+  return function informar(info) {
+    try {
+      const vista = String((info && info.vista) || '?');
+      const mensaje = String((info && info.mensaje) || 'error sin mensaje').slice(0, 500);
+      const clave = vista + '|' + mensaje;
+      const t = ahora();
+      const ultimo = vistos.get(clave);
+      if (ultimo != null && t - ultimo < VENTANA_MS) return false;
+      if (enviados >= TOPE) return false;
+      vistos.set(clave, t); enviados++;
+      const p = enviar({ vista, mensaje, pila: String((info && info.pila) || '').slice(0, 1500), componente: String((info && info.componente) || '').slice(0, 600) });
+      if (p && typeof p.catch === 'function') p.catch(() => { /* sin puente */ });
+      return true;
+    } catch (e) { return false; }
+  };
+}
+
+/* Engancha window.onerror y unhandledrejection. `vistaActual()` dice en qué pantalla estaba el usuario. */
+export function vigilarErroresGlobales(enviar, vistaActual = () => '?') {
+  const informar = crearInformador(enviar);
+  window.addEventListener('error', (e) => {
+    informar({ vista: 'global:' + vistaActual(), mensaje: (e && e.message) || String(e && e.error), pila: e && e.error && e.error.stack });
+  });
+  window.addEventListener('unhandledrejection', (e) => {
+    const r = e && e.reason;
+    informar({ vista: 'promesa:' + vistaActual(), mensaje: (r && r.message) || String(r), pila: r && r.stack });
+  });
+  return informar;
+}
