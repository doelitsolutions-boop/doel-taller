+/* v0.1.85 · ✉️ Avisos automáticos al cliente por correo.
+
+   Hasta ahora avisar era siempre a mano: al pasar a LISTO saltaba la ventana con el texto y alguien pulsaba WhatsApp
+   o correo. Ahora, con «Avisos automáticos por correo» activado en Ajustes → Taller, el programa ENCOLA un correo en
+   los momentos que se elijan (recibido, presupuesto emitido, listo, recordatorio de recogida) y el proceso principal
+   lo manda por la nube de Doel (electron/avisos.cjs → /api/aviso-enviar), que es quien tiene el proveedor de correo.
+   La ventana de aviso manual sigue existiendo (WhatsApp, llamada): lo automático es el correo.
+
+   Reglas:
+   · solo clientes con email; un cliente con «📞 Llamada» como contacto preferido no recibe correos automáticos;
+     en modo «preferencia» solo los que tienen «✉️ Email» como preferido;
+   · nunca dos correos iguales seguidos: misma orden y tipo pendiente → no se repite; el mismo tipo enviado hace
+     menos de 10 minutos → tampoco (el recordatorio se controla por días);
+   · cada envío queda como aviso de la orden (ordenes_avisos, vía «email»): es la prueba documental que arranca el
+     plazo de almacenaje, igual que el aviso manual;
+   · si la nube falla, el correo se queda en cola y se reintenta (5 veces con espera creciente); sin internet no
+     cuenta como intento. Plantillas editables en config (avisos_asunto_<tipo>, avisos_texto_<tipo>), vacías = las
+     de fábrica. */
+const N = require('./_nucleo.cjs');
+
+const TIPOS = ['recibido', 'presupuesto', 'listo', 'recordatorio'];
+const PLANTILLAS = {
+  recibido: {
+    asunto: 'Hemos recibido {equipo} · orden {orden}',
+    texto: 'Hola {nombre} 👋\n\nHemos recibido {equipo} en {taller} con el número de orden {orden}.\nLe avisaremos por este medio en cuanto tengamos el diagnóstico o el presupuesto.{portal_linea}\n\nGracias por confiar en nosotros.\n— {taller}{telefono_linea}',
+  },
+  presupuesto: {
+    asunto: 'Presupuesto de {equipo} · orden {orden} · {total}',
+    texto: 'Hola {nombre} 👋\n\nYa tenemos el presupuesto de {equipo} (orden {orden}):\n{lineas}\nTOTAL: {total} (IGIC incluido){anticipo_linea}\n\nResponda a este correo con ACEPTO para que empecemos, o díganos si tiene dudas.{portal_linea}\n— {taller}{telefono_linea}',
+  },
+  listo: {
+    asunto: '{equipo} está listo para recoger · orden {orden}',
+    texto: 'Hola {nombre} 👋\n\n{equipo} (orden {orden}) ya está listo para recoger en {taller}.{pendiente_linea}\n\nHorario y dirección, en su resguardo. Si no puede pasar en los próximos días, díganoslo respondiendo a este correo.\n— {taller}{telefono_linea}',
+  },
+  recordatorio: {
+    asunto: 'Recordatorio: {equipo} sigue esperándole · orden {orden}',
+    texto: 'Hola {nombre} 👋\n\nLe recordamos que {equipo} (orden {orden}) está listo para recoger en {taller} desde hace {dias} días.{pendiente_linea}\nPasados {almacenaje_dias} días desde el aviso puede aplicarse el coste de almacenaje que figura en el resguardo.\n— {taller}{telefono_linea}',
+  },
+};
+const CAMPOS = ['{nombre}', '{equipo}', '{orden}', '{taller}', '{telefono_taller}', '{telefono_linea}', '{total}', '{lineas}', '{anticipo_linea}', '{pendiente_linea}', '{portal}', '{portal_linea}', '{dias}', '{almacenaje_dias}'];
+
+const eurTxt = (n) => (Number(n) || 0).toFixed(2).replace('.', ',') + ' €';
+
+function avisosConfig() {
+  const c = N.API.configAll();
+  return {
+    auto: c.avisos_email_auto === '1',
+    modo: c.avisos_email_modo === 'preferencia' ? 'preferencia' : 'todos',
+    responder: String(c.avisos_email_responder || '').trim(),
+    tipos: Object.fromEntries(TIPOS.map((t) => [t, (c['avisos_email_' + t] ?? '1') !== '0'])),
+  };
+}
+
+/* Plantilla vigente por tipo: la de config si no está vacía, si no la de fábrica. */
+function avisosPlantillas() {
+  const c = N.API.configAll();
+  const out = {};
+  for (const t of TIPOS) {
+    const asunto = String(c['avisos_asunto_' + t] || '').trim(), texto = String(c['avisos_texto_' + t] || '').trim();
+    out[t] = { asunto: asunto || PLANTILLAS[t].asunto, texto: texto || PLANTILLAS[t].texto, porDefecto: PLANTILLAS[t], personalizada: !!(asunto || texto) };
+  }
+  return { tipos: TIPOS, plantillas: out, campos: CAMPOS };
+}
+
+/* Los datos de la orden que rellenan la plantilla. `o` es ordenGet (cliente, equipo, líneas, totales). */
+function datosDeOrden(o, extra = {}) {
+  const emp = N.db.prepare('SELECT nombre, telefono FROM empresa WHERE id = 1').get() || {};
+  const cfg = N.API.configAll();
+  const cli = o.cliente || {};
+  const eq = o.equipo ? `${o.equipo.marca || ''} ${o.equipo.modelo || ''}`.trim() || 'su equipo' : 'su equipo';
+  const total = Number(o.total_presupuesto) || 0, anticipo = Number(o.total_anticipado) || 0;
+  const lineas = (o.lineas || []).map((l) => { const c = Number(l.cantidad) || 1; return `• ${l.descripcion}${c !== 1 ? ' ×' + c : ''}: ${eurTxt(c * (Number(l.precio) || 0))}`; }).join('\n');
+  const portal = cfg.portal_url ? String(cfg.portal_url).trim().replace(/\/+$/, '') + '/portal.html' + (cfg.reserva_slug ? '?n=' + encodeURIComponent(cfg.reserva_slug) : '') : '';
+  const resto = Math.max(0, total - anticipo);
+  const tiempos = N.API.tallerTiempos ? N.API.tallerTiempos() : {};
+  return {
+    '{nombre}': String(cli.nombre || '').split(' ')[0] || '',
+    '{equipo}': eq, '{orden}': o.numero || '', '{taller}': emp.nombre || 'Doel Taller',
+    '{telefono_taller}': emp.telefono || '', '{telefono_linea}': emp.telefono ? ' · ' + emp.telefono : '',
+    '{total}': eurTxt(total), '{lineas}': lineas,
+    '{anticipo_linea}': anticipo > 0 ? `\nA cuenta ya entregado: ${eurTxt(anticipo)} · resto: ${eurTxt(resto)}` : '',
+    '{pendiente_linea}': resto > 0 && total > 0 ? `\nQueda por abonar: ${eurTxt(resto)}.` : '',
+    '{portal}': portal, '{portal_linea}': portal ? `\nTambién puede seguirlo o aceptarlo desde su portal: ${portal} (entre con su teléfono y la clave del resguardo).` : '',
+    '{dias}': String(extra.dias != null ? extra.dias : ''), '{almacenaje_dias}': String(tiempos.almacenaje_dias || cfg.taller_almacenaje_dias || 30),
+  };
+}
+const rellenar = (plantilla, datos) => String(plantilla || '').replace(/\{[a-z_]+\}/g, (k) => (k in datos ? datos[k] : k));
+
+/* Correo listo para mandar (sin encolar): { para, asunto, texto }. */
+function avisoRender(tipo, ordenId, extra = {}) {
+  if (!TIPOS.includes(tipo)) throw new Error('Tipo de aviso desconocido: ' + tipo);
+  const o = N.API.ordenGet(ordenId);
+  if (!o) throw new Error('Orden no encontrada');
+  const pl = avisosPlantillas().plantillas[tipo];
+  const datos = datosDeOrden(o, extra);
+  const cli = N.db.prepare('SELECT email, contacto_pref FROM clientes WHERE id = ?').get(o.cliente_id) || {};
+  return { para: String(cli.email || '').trim().toLowerCase() || null, preferencia: cli.contacto_pref || null,
+    asunto: rellenar(pl.asunto, datos).replace(/\s+/g, ' ').trim().slice(0, 150), texto: rellenar(pl.texto, datos).trim().slice(0, 6000), orden: o };
+}
+
+/* Encola el correo si procede. opts.forzar salta los interruptores (botón manual «enviar por correo»), nunca la
+   falta de email. Devuelve { encolado, motivo | id, para, asunto }. */
+function avisoEncolar(ordenId, tipo, opts = {}) {
+  const cfg = avisosConfig();
+  if (!TIPOS.includes(tipo)) throw new Error('Tipo de aviso desconocido: ' + tipo);
+  if (!opts.forzar && (!cfg.auto || !cfg.tipos[tipo])) return { encolado: false, motivo: 'desactivado' };
+  const r = avisoRender(tipo, ordenId, opts);
+  if (!r.para) return { encolado: false, motivo: 'sin_email' };
+  if (!opts.forzar && r.preferencia === 'llamada') return { encolado: false, motivo: 'prefiere_llamada' };
+  if (!opts.forzar && cfg.modo === 'preferencia' && r.preferencia !== 'email') return { encolado: false, motivo: 'preferencia' };
+  if (N.db.prepare("SELECT 1 FROM avisos_cola WHERE orden_id = ? AND tipo = ? AND estado = 'pendiente'").get(ordenId, tipo)) return { encolado: false, motivo: 'repetido' };
+  if (tipo !== 'recordatorio' && N.db.prepare("SELECT 1 FROM avisos_cola WHERE orden_id = ? AND tipo = ? AND estado = 'enviado' AND enviado_en >= datetime('now','localtime','-10 minutes')").get(ordenId, tipo)) return { encolado: false, motivo: 'reciente' };
+  const id = N.db.prepare('INSERT INTO avisos_cola (orden_id, tipo, via, para, asunto, texto) VALUES (?,?,?,?,?,?)').run(ordenId, tipo, 'email', r.para, r.asunto, r.texto).lastInsertRowid;
+  try { N.API.ordenLog(ordenId, opts.usuarioId || null, 'aviso', 'Correo «' + tipo + '» en cola para ' + r.para); } catch (e) { /* el rastro es lo de menos */ }
+  return { encolado: true, id, para: r.para, asunto: r.asunto };
+}
+
+const avisosPendientes = (n = 10) => N.db.prepare(`SELECT * FROM avisos_cola WHERE estado = 'pendiente' AND (proximo_intento IS NULL OR proximo_intento <= ?) ORDER BY id LIMIT ?`).all(N.nowISO(), Math.max(1, Math.min(50, Number(n) || 10)));
+
+const REINTENTOS_MAX = 5;
+/* Lo que dice la nube de cada correo. `definitivo` = no vale la pena reintentar (destinatario mal formado). */
+function avisoResultado(id, ok, error = null, definitivo = false) {
+  const a = N.db.prepare('SELECT * FROM avisos_cola WHERE id = ?').get(id);
+  if (!a || a.estado !== 'pendiente') return null;
+  if (ok) {
+    N.db.prepare("UPDATE avisos_cola SET estado = 'enviado', enviado_en = ?, ultimo_error = NULL WHERE id = ?").run(N.nowISO(), id);
+    try { N.API.ordenAvisoAdd(a.orden_id, a.tipo, 'email'); } catch (e) { /* sin rastro: el correo salió igual */ }
+    try { N.API.ordenLog(a.orden_id, null, 'aviso', 'Correo «' + a.tipo + '» enviado a ' + a.para); } catch (e) { /* nada */ }
+    return 'enviado';
+  }
+  const intentos = (a.intentos || 0) + 1;
+  const msg = String(error || 'error desconocido').slice(0, 300);
+  if (definitivo || intentos >= REINTENTOS_MAX) {
+    N.db.prepare("UPDATE avisos_cola SET estado = 'fallo', intentos = ?, ultimo_error = ? WHERE id = ?").run(intentos, msg, id);
+    try { N.API.ordenLog(a.orden_id, null, 'aviso', 'Correo «' + a.tipo + '» NO enviado a ' + a.para + ': ' + msg); } catch (e) { /* nada */ }
+    return 'fallo';
+  }
+  const esperaMs = Math.min(3600000, 60000 * Math.pow(2, intentos - 1)); // 1, 2, 4, 8 min
+  N.db.prepare("UPDATE avisos_cola SET intentos = ?, ultimo_error = ?, proximo_intento = ? WHERE id = ?").run(intentos, msg, N.dentroDe(esperaMs), id);
+  return 'reintento';
+}
+
+const avisosCola = (n = 50) => N.db.prepare(`SELECT a.*, o.numero orden_numero, c.nombre cliente FROM avisos_cola a
+  JOIN ordenes o ON o.id = a.orden_id LEFT JOIN clientes c ON c.id = o.cliente_id ORDER BY a.id DESC LIMIT ?`).all(Math.max(1, Math.min(200, Number(n) || 50)));
+function avisoReintentar(id) { N.db.prepare("UPDATE avisos_cola SET estado = 'pendiente', intentos = 0, proximo_intento = NULL WHERE id = ? AND estado IN ('fallo','descartado')").run(id); return avisosCola(50); }
+function avisoDescartar(id) { N.db.prepare("UPDATE avisos_cola SET estado = 'descartado' WHERE id = ? AND estado IN ('pendiente','fallo')").run(id); return avisosCola(50); }
+function avisosResumen() {
+  const por = Object.fromEntries(N.db.prepare('SELECT estado, COUNT(*) n FROM avisos_cola GROUP BY estado').all().map((r) => [r.estado, r.n]));
+  let ultimo = null; try { ultimo = JSON.parse(N.API.configAll().avisos_ultimo || 'null'); } catch (e) { ultimo = null; }
+  return { pendientes: por.pendiente || 0, enviados: por.enviado || 0, fallos: por.fallo || 0, descartados: por.descartado || 0, ultimo, config: avisosConfig() };
+}
+
+/* Recordatorios de recogida: LISTO desde hace ≥ recordatorio_dias, sin recordatorio (de ninguna vía) en ese plazo. */
+function avisosRecordatoriosBarrer() {
+  const cfg = avisosConfig();
+  if (!cfg.auto || !cfg.tipos.recordatorio) return { encolados: 0 };
+  const tiempos = N.API.tallerTiempos ? N.API.tallerTiempos() : {};
+  const dias = Number(tiempos.recordatorio_dias || N.API.configAll().taller_recordatorio_dias) || 7;
+  const filas = N.db.prepare(`SELECT o.id, CAST(julianday('now','localtime') - julianday(o.almacenaje_desde) AS INTEGER) dias FROM ordenes o
+    WHERE o.estado = 'listo' AND o.almacenaje_desde IS NOT NULL AND julianday('now','localtime') - julianday(o.almacenaje_desde) >= ?
+    AND NOT EXISTS (SELECT 1 FROM ordenes_avisos v WHERE v.orden_id = o.id AND v.tipo = 'recordatorio' AND julianday('now','localtime') - julianday(v.enviado) < ?)
+    AND NOT EXISTS (SELECT 1 FROM avisos_cola q WHERE q.orden_id = o.id AND q.tipo = 'recordatorio' AND q.estado = 'pendiente')`).all(dias, dias);
+  let encolados = 0;
+  for (const f of filas) { try { if (avisoEncolar(f.id, 'recordatorio', { dias: f.dias }).encolado) encolados++; } catch (e) { /* una orden rara no para a las demás */ } }
+  return { encolados, revisadas: filas.length };
+}
+
+Object.assign(N.API, { avisosPlantillas, avisoRender, avisoEncolar, avisosPendientes, avisoResultado, avisosCola, avisoReintentar, avisoDescartar, avisosResumen, avisosRecordatoriosBarrer, AVISOS_TIPOS: TIPOS });
+module.exports = { TIPOS, PLANTILLAS, rellenar };
