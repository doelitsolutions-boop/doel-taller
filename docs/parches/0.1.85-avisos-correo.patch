@@ -0,0 +1,74 @@
+/* v0.1.85 · ✉️ Envío de los avisos por correo que la capa de datos deja en cola (avisos_cola).
+   Patrón portal.cjs: el TPV habla con la nube de Doel cuando hay internet; sin red, la cola espera. La nube
+   (/api/aviso-enviar, mismo token y slug que el portal) es la que tiene el proveedor de correo (SMTP de Gmail,
+   Brevo o Resend: variables de entorno en Netlify, nunca en el TPV ni en la base). */
+let timer = null;
+
+function destino(db) {
+  const cfg = db.configAll();
+  let url = String(cfg.portal_url || '').trim();
+  const clave = String(cfg.portal_token || '').trim();
+  if (!url || !clave) throw new Error('Configura la dirección de la nube y su token en Ajustes → 🔧 Taller (infraestructura)');
+  if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
+  let base;
+  try { base = new URL(url).origin; } catch (e) { throw new Error('La dirección de la nube no es válida (debe ser https://tu-sitio.netlify.app)'); }
+  const slug = String(cfg.reserva_slug || '').trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');
+  return { base, clave, slug, cfg };
+}
+
+async function llamar(db, avisos) {
+  const d = destino(db);
+  const emp = db.getEmpresa() || {};
+  const res = await fetch(d.base + '/api/aviso-enviar' + (d.slug ? '?n=' + encodeURIComponent(d.slug) : ''), {
+    method: 'POST', headers: { 'content-type': 'application/json', authorization: 'Bearer ' + d.clave },
+    body: JSON.stringify({ negocio: { nombre: emp.nombre || 'Taller', telefono: emp.telefono || '', responder: String(d.cfg.avisos_email_responder || '').trim() }, avisos }),
+  });
+  if (res.status === 401) throw new Error('La nube rechazó el token del portal (revisa Ajustes → Taller → infraestructura)');
+  let data = null; try { data = await res.json(); } catch (e) { data = null; }
+  if (!res.ok) throw new Error('Nube de avisos: HTTP ' + res.status + (data && data.error ? ' — ' + data.error : ''));
+  return data || {};
+}
+
+/* Manda hasta `max` correos pendientes. Si la nube no contesta (sin internet, 5xx), nada cuenta como intento. */
+async function enviarPendientes(db, max = 10) {
+  db.avisosRecordatoriosBarrer();
+  const pend = db.avisosPendientes(max);
+  if (!pend.length) return { enviados: 0, fallos: 0, reintentos: 0, pendientes: 0 };
+  const data = await llamar(db, pend.map((a) => ({ id: a.id, para: a.para, asunto: a.asunto, texto: a.texto })));
+  let enviados = 0, fallos = 0, reintentos = 0;
+  for (const r of data.resultados || []) {
+    const que = db.avisoResultado(r.id, !!r.ok, r.error || null, !!r.definitivo);
+    if (que === 'enviado') enviados++; else if (que === 'fallo') fallos++; else if (que === 'reintento') reintentos++;
+  }
+  const resumen = { ok: true, cuando: new Date().toISOString(), enviados, fallos, reintentos, proveedor: data.proveedor || null, pendientes: db.avisosPendientes(50).length };
+  db.configSet('avisos_ultimo', JSON.stringify(resumen));
+  return resumen;
+}
+
+/* Un correo de prueba a la dirección que se indique (Ajustes): comprueba nube, token y proveedor de una vez. */
+async function probar(db, para) {
+  const dir = String(para || '').trim().toLowerCase();
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(dir)) throw new Error('Escribe una dirección de correo válida');
+  const emp = db.getEmpresa() || {};
+  const data = await llamar(db, [{ id: 0, para: dir, asunto: 'Prueba de avisos de ' + (emp.nombre || 'Doel Taller'), texto: 'Este es un correo de prueba de los avisos automáticos de ' + (emp.nombre || 'Doel Taller') + '.\nSi lo lees, la nube y el proveedor de correo están bien configurados.\n\n— ' + (emp.nombre || 'Doel Taller') + (emp.telefono ? ' · ' + emp.telefono : '') }]);
+  const r = (data.resultados || [])[0] || {};
+  if (!r.ok) throw new Error(r.error || 'La nube no pudo enviar la prueba');
+  return { ok: true, proveedor: data.proveedor || null, para: dir };
+}
+
+function iniciar(db, intervaloMs = 60000) {
+  const tick = async () => {
+    try {
+      const c = db.configAll();
+      if (c.avisos_email_auto === '1' && c.portal_url && c.portal_token) await enviarPendientes(db);
+    } catch (e) {
+      try { db.configSet('avisos_ultimo', JSON.stringify({ ok: false, cuando: new Date().toISOString(), error: e.message })); } catch (x) { /* sin db */ }
+    }
+  };
+  clearInterval(timer);
+  timer = setInterval(tick, intervaloMs);
+  setTimeout(tick, 20000);
+}
+function detener() { clearInterval(timer); timer = null; }
+
+module.exports = { enviarPendientes, probar, iniciar, detener, destino };
