diff --git a/electron/main/avisos.cjs b/electron/main/avisos.cjs
new file mode 100644
index 0000000..79d6665
--- /dev/null
+++ b/electron/main/avisos.cjs
@@ -0,0 +1,14 @@
+/* v0.1.85 · ✉️ Avisos automáticos por correo: canales del puente y el envío periódico. Dominio de main (AUD-04). */
+module.exports = (ctx) => {
+  const { handle, db } = ctx;
+  const avisos = require('../avisos.cjs');
+  handle('avisos:plantillas', () => db.avisosPlantillas());
+  handle('avisos:cola', (n) => ({ cola: db.avisosCola(n), resumen: db.avisosResumen() }));
+  handle('avisos:encolar', (ordenId, tipo, usuarioId) => db.avisoEncolar(ordenId, tipo, { forzar: true, usuarioId })); // botón manual: salta los interruptores, no la falta de email
+  handle('avisos:enviar-ahora', () => avisos.enviarPendientes(db));
+  handle('avisos:probar', (para) => avisos.probar(db, para));
+  handle('avisos:reintentar', (id) => db.avisoReintentar(id));
+  handle('avisos:descartar', (id) => db.avisoDescartar(id));
+  avisos.iniciar(db); // cada minuto, solo con el interruptor activado y la nube configurada
+  return avisos;
+};
