+    if (nuevo === undefined) return actual;
+    const r = await store.setJSON(clave, nuevo, leido && leido.etag ? { onlyIfMatch: leido.etag } : { onlyIfNew: true });
+    if (!r || r.modified !== false) return nuevo;
+    await new Promise((res) => setTimeout(res, 15 + Math.random() * 60));
+  }
+  throw new Error('No se pudo guardar «' + clave + '»: demasiadas escrituras a la vez');
