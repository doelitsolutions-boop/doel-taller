+async function modificar(store, clave, fn, defecto) {
+  for (let intento = 0; intento < 5; intento++) {
+    const leido = await store.getWithMetadata(clave, { type: 'json' });
+    const actual = leido && leido.data != null ? leido.data : (typeof defecto === 'function' ? defecto() : structuredClone(defecto));
