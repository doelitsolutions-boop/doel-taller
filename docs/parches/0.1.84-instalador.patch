@@ -0,0 +1,26 @@
+#!/usr/bin/env node
+/* v0.1.84 · ¿Existe el binario precompilado de better-sqlite3 para el Electron del proyecto en Windows x64?
+   Si no existe, electron-builder compila desde el código fuente y en un PC sin Visual Studio Build Tools el
+   instalador NO sale (pasó en la 0.1.76 → 0.1.83 con Electron 44 y better-sqlite3 13). Ejecutar antes de
+   subir Electron o better-sqlite3: node tools/comprobar-prebuild.cjs [--electron 44.9.0] [--sqlite 13.0.3] */
+const https = require('https');
+const path = require('path');
+process.chdir(path.join(__dirname, '..'));
+const arg = (n) => { const i = process.argv.indexOf('--' + n); return i > 0 ? process.argv[i + 1] : null; };
+const electron = arg('electron') || require('electron/package.json').version;
+const sqlite = arg('sqlite') || require('better-sqlite3/package.json').version;
+const abi = require('node-abi').getAbi(electron, 'electron');
+const url = `https://github.com/WiseLibs/better-sqlite3/releases/download/v${sqlite}/better-sqlite3-v${sqlite}-electron-v${abi}-win32-x64.tar.gz`;
+const pedir = (u, saltos = 0) => new Promise((res, rej) => {
+  https.request(u, { method: 'HEAD' }, (r) => {
+    if ([301, 302, 307, 308].includes(r.statusCode) && saltos < 5 && r.headers.location && !/releases\/download/.test(r.headers.location)) return res(r.statusCode); // el 302 al CDN ya dice que existe
+    res(r.statusCode);
+  }).on('error', rej).end();
+});
+pedir(url).then((code) => {
+  const hay = code === 302 || code === 200;
+  console.log(`Electron ${electron} (ABI ${abi}) · better-sqlite3 ${sqlite} · win32-x64 → ${hay ? 'HAY precompilado ✅' : 'NO hay precompilado ❌ (HTTP ' + code + ')'}`);
+  console.log(url);
+  if (!hay) console.log('Sin precompilado, electron-builder compila desde el código fuente: en un PC sin Visual Studio Build Tools el instalador no sale.');
+  process.exit(hay ? 0 : 1);
+}).catch((e) => { console.log('No se pudo comprobar: ' + e.message); process.exit(2); });
