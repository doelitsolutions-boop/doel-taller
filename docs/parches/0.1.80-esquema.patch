+/* v0.1.80 · punto 7 · contador atómico en la tabla `contadores` (clave → valor). La primera vez arranca en semilla()
+   (el máximo que ya exista en la tabla de destino), así una instalación viva sigue donde iba. UPDATE … RETURNING es
+   una sola sentencia: dos puestos pidiendo número a la vez no se pisan. */
+function contadorSiguiente(clave, semilla = () => 0) {
+  if (!N.db.prepare('SELECT 1 FROM contadores WHERE clave = ?').get(clave)) {
+    N.db.prepare('INSERT OR IGNORE INTO contadores (clave, valor) VALUES (?, ?)').run(clave, Math.max(0, Number(semilla()) || 0));
+  }
+  return N.db.prepare('UPDATE contadores SET valor = valor + 1 WHERE clave = ? RETURNING valor').get(clave).valor;
+}
+N.contadorSiguiente = contadorSiguiente;
+
