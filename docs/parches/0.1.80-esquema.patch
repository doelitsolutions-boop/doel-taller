+/* v0.1.80 · punto 7 · SQLite no añade REFERENCES con ALTER TABLE: se crea la tabla nueva con las columnas canónicas (ya
+   con sus FK), se le suman tal cual las columnas que esa instalación tenga de más, se copian los datos, se renombra y se
+   vuelven a crear sus índices. Solo actúa si la DDL actual no lleva ya la referencia (`senal`). Va con foreign_keys en
+   OFF durante la copia (como las migraciones de productos y tickets) y lo deja como estaba. */
+function reconstruirConFK(tabla, canon, senal) {
+  const fila = N.db.prepare("SELECT sql FROM sqlite_master WHERE type='table' AND name=?").get(tabla);
+  if (!fila || !fila.sql || senal.test(fila.sql)) return false;
+  const cols = N.db.prepare(`PRAGMA table_info(${tabla})`).all();
+  const defs = cols.map((c) => canon[c.name] || (c.name + ' ' + (c.type || 'TEXT') + (c.notnull ? ' NOT NULL' : '') + (c.dflt_value != null ? ' DEFAULT ' + c.dflt_value : '')));
+  const lista = cols.map((c) => c.name).join(', ');
+  const indices = N.db.prepare("SELECT sql FROM sqlite_master WHERE type='index' AND tbl_name=? AND sql IS NOT NULL").all(tabla).map((i) => i.sql);
+  const fkAntes = N.db.pragma('foreign_keys', { simple: true });
+  N.db.pragma('foreign_keys = OFF');
+  try {
+    N.db.transaction(() => {
+      N.db.exec(`CREATE TABLE ${tabla}_mig (${defs.join(', ')})`);
+      N.db.exec(`INSERT INTO ${tabla}_mig (${lista}) SELECT ${lista} FROM ${tabla}`);
+      N.db.exec(`DROP TABLE ${tabla}`);
+      N.db.exec(`ALTER TABLE ${tabla}_mig RENAME TO ${tabla}`);
+      for (const s of indices) N.db.exec(s.replace(/^CREATE (UNIQUE )?INDEX (IF NOT EXISTS )?/i, (m, u) => 'CREATE ' + (u || '') + 'INDEX IF NOT EXISTS '));
+    })();
+  } finally { N.db.pragma('foreign_keys = ' + (fkAntes ? 'ON' : 'OFF')); }
+  return true;
+}
